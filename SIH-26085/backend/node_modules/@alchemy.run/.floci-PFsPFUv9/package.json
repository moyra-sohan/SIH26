{
  "name": "@alchemy.run/floci",
  "version": "2.0.0-beta.74",
  "description": "Effect-native manager for the floci local cloud emulator: ensure the container is running, health-gate it, and resolve the endpoint for alchemy's AWS local dev.",
  "homepage": "https://alchemy.run",
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "keywords": [
    "alchemy",
    "aws",
    "effect",
    "emulator",
    "floci"
  ],
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/floci"
  },
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "files": [
    "lib",
    "src",
    "NOTICE"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.110 || >=4.0.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "effect": ">=4.0.0-rc.110 || >=4.0.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsc -b && bun ../../scripts/copy-package-files.ts floci"
  }
}