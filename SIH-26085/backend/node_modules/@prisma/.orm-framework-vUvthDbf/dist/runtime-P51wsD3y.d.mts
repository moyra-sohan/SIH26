 * @example
 * ```typescript
 * class SelectQuery<Row> {
 *   annotate<As extends readonly AnnotationValue<unknown, OperationKind>[]>(
 *     ...annotations: As & ValidAnnotations<'read', As>
 *   ): SelectQuery<Row>;
 * }
