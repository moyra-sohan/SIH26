# Neon PostgreSQL Connection URL
DATABASE_URL="postgresql://username:password@host/database?sslmode=require"

# Server Port
PORT=5000

# Secret key for signing JWT tokens
JWT_SECRET="your_secure_random_jwt_secret_here"

# Secret key for cookies (must be at least 32 characters)
COOKIE_SECRET="your_secure_random_cookie_secret_at_least_32_chars"

# Secret key for sessions (must be at least 32 characters)
SESSION_SECRET="your_secure_random_session_secret_at_least_32_chars"
