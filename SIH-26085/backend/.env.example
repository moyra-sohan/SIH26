# Neon PostgreSQL Connection URL
DATABASE_URL="postgresql://username:password@host/database?sslmode=require"

# Server Port
PORT=5000

# Secret key for signing JWT tokens
JWT_SECRET="your_secure_random_jwt_secret_here"

# Machine Learning Backend API URL (Python FastAPI / uvicorn)
ML_SERVICE_URL="http://127.0.0.1:8000"

# OpenWeatherMap API Key — get yours FREE at https://home.openweathermap.org/api_keys
# The frontend NEVER sees this key. It stays server-side only.
WEATHER_API_KEY=your_openweathermap_api_key_here

# Weather refresh interval for frontend auto-refresh (minutes)
WEATHER_REFRESH_INTERVAL_MINUTES=10
